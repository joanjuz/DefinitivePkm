{
  "name": "pokejuz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "sync:releases": "node scripts/sync-releases.mjs",
    "test": "node --test scripts/sync-releases.test.mjs",
    "verify:launch": "node scripts/sync-releases.mjs --require-launch",
    "check": "astro check",
    "build": "npm run sync:releases && astro build",
    "build:pages": "npm run verify:launch && astro build",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "~5.9.3"
  }
}
