---
interface Props {
  id: string;
  title: string;
  description: string;
  availability: string;
  compatibility: string;
  validation: string;
  documentation: string;
  reverse?: boolean;
}
const { id, title, description, availability, compatibility, validation, documentation, reverse = false } = Astro.props;
---
<section class:list={['feature-section', 'wrap', { 'feature-reverse': reverse }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="feature-copy">
    <p class="feature-availability">{availability}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p class="feature-lead">{description}</p>
    <div class="feature-details-copy"><slot /></div>
    <a class="text-link" href={documentation}>Consultar documentación <span aria-hidden="true">↗</span></a>
  </div>
  <div class="feature-evidence">
    <slot name="visual" />
    <dl class="sync-facts">
      <div><dt>Compatibilidad</dt><dd>{compatibility}</dd></div>
      <div><dt>Estado de validación</dt><dd>{validation}</dd></div>
    </dl>
    <slot name="technical" />
  </div>
</section>
