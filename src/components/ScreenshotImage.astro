---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
interface Props { image: ImageMetadata; alt: string; caption: string; label: string; eager?: boolean; sizes?: string; }
const { image, alt, caption, label, eager = false, sizes = '(max-width: 760px) 90vw, 54vw' } = Astro.props;
---
<figure class="product-image">
  <a class="screenshot-link" href={image.src} data-screenshot data-caption={caption} aria-label={label}>
    <Image src={image} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} format="webp" quality={85} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
    <span class="expand-label"><Icon name="expand" /> Ampliar</span>
  </a>
  <figcaption>{caption}</figcaption>
</figure>
