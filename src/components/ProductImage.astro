---
import ScreenshotImage from './ScreenshotImage.astro';
import type { Product, ProductScreenshot } from '../data/products';
interface Props { product: Product; eager?: boolean; screenshot?: ProductScreenshot; sizes?: string; }
const { product, eager = false, screenshot, sizes } = Astro.props;
const image = screenshot?.image ?? product.image;
const alt = screenshot?.alt ?? product.imageAlt;
const caption = screenshot?.caption ?? product.imageCaption;
const label = screenshot ? `Ampliar ${screenshot.title} de ${product.name}` : `Ampliar captura de ${product.name}`;
---
<ScreenshotImage {image} {alt} {caption} {label} {eager} {sizes} />
