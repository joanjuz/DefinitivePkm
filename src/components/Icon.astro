---
interface Props { name: 'download' | 'arrow' | 'external' | 'coffee' | 'expand' | 'close'; }
const { name } = Astro.props;
const paths = {
  download: ['M12 3v12', 'm7 10 5 5 5-5', 'M5 17v4h14v-4'],
  arrow: ['M5 12h14', 'm12 5 7 7-7 7'],
  external: ['M14 3h7v7', 'M21 3 10 14', 'M10 3H3v18h18v-7'],
  coffee: ['M3 8h13v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z', 'M16 8h2a3 3 0 1 1 0 6h-2', 'M6 2v2', 'M10 2v2'],
  expand: ['M8 3H3v5', 'M16 3h5v5', 'M3 16v5h5', 'M21 16v5h-5'],
  close: ['m6 6 12 12', 'M18 6 6 18'],
};
---
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{paths[name].map(d => <path d={d} />)}</svg>
