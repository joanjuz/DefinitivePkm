---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import ScreenshotDialog from '../components/ScreenshotDialog.astro';
import { sitePath } from '../data/products';
interface Props { title?: string; description?: string; }
const { title = 'PokeJuz · Definitive Randomizer y Pokémon Tracker Progressive', description = 'Edita y randomiza tus juegos con Definitive Randomizer. Consulta tu equipo en vivo con Pokémon Tracker Progressive. Descargas oficiales gratuitas para Windows.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
const analyticsEnabled = Boolean(analyticsToken && /^[a-f\d]{32}$/i.test(analyticsToken));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#15171a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="PokeJuz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="color-scheme" content="dark" />
    {analyticsEnabled && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header wrap">
      <a class="wordmark" href={sitePath()} aria-label="PokeJuz, inicio">Poke<span>Juz</span></a>
      <nav aria-label="Navegación principal">
        <a href={sitePath('#herramientas')}>Herramientas</a>
        <a href={sitePath('#minijuegos')}>Minijuegos</a>
        <a href={sitePath('#descargas')}>Descargas</a>
        <a class="support-link" href={sitePath('#apoyar')}><Icon name="coffee" />Apoyar</a>
      </nav>
    </header>
    <main id="contenido" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <a class="wordmark footer-wordmark" href={sitePath()}>Poke<span>Juz</span></a>
      <a href="https://github.com/joanjuz">Herramientas de joanjuz <Icon name="external" /></a>
      <a href={sitePath('privacidad/')}>Privacidad</a>
      <a href="#contenido">Volver arriba ↑</a>
    </footer>
    <ScreenshotDialog />
  </body>
</html>
