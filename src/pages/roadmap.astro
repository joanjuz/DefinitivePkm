---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../data/products';

const initiatives = [
  { status: 'En validación', title: 'Definitive Randomizer', description: 'Terminar Preview 3, verificar el paquete final y reforzar la seguridad para llegar a una primera versión estable.', link: 'https://github.com/joanjuz/Definitive-Randomizer' },
  { status: 'Evolución continua', title: 'Progressive Tracker', description: 'Compatibilidad con emuladores y revisiones, sesiones confiables, OBS e integración con datos exportados del randomizador.', link: 'https://github.com/joanjuz/NuzlockeTracker' },
  { status: 'Investigación', title: 'Mentas y objetos especiales', description: 'Mentas Gen 7 como objetos utilizables en tiendas y field items; estudiar caramelos raros y repelentes con mejoras opcionales.', link: 'https://github.com/joanjuz/Definitive-Randomizer' },
  { status: 'Planificado', title: 'Randomización DS avanzada', description: 'Estudiar DSPRE para ofrecer más control de entrenadores, encuentros, objetos y eventos.', link: 'https://github.com/joanjuz/Definitive-Randomizer' },
  { status: 'Diseño futuro', title: 'Perfiles y Definitive Hub', description: 'Exportar perfiles desde proyectos, combinar modificaciones compatibles y construir después una biblioteca comunitaria.', link: 'https://github.com/joanjuz/DefinitivePkm/blob/main/docs/ROADMAP.md' },
  { status: 'Largo plazo', title: 'Editor visual DS', description: 'Simplificar la edición de eventos y, finalmente, mapas sin depender de múltiples herramientas.', link: 'https://github.com/joanjuz/Definitive-Randomizer' }
];
---
<Layout title="Roadmap · PokeJuz" description="La visión y las iniciativas de Definitive Randomizer, Progressive Tracker y su comunidad.">
  <section class="roadmap-hero wrap">
    <p class="eyebrow">Nuestra dirección</p>
    <h1>Lo que estamos construyendo</h1>
    <p>El usuario decide qué quiere hacer. La complejidad debe resolverla la herramienta.</p>
    <p class="note">Este roadmap comparte prioridades e ideas en investigación, no compromisos de fecha ni garantías de compatibilidad. Las versiones publicadas se consultan en GitHub Releases.</p>
  </section>
  <section class="wrap roadmap-body" aria-labelledby="initiatives-title">
    <h2 id="initiatives-title">Iniciativas</h2>
    <div class="initiative-grid">
      {initiatives.map(item => <article class="initiative">
        <p class="status">{item.status}</p>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <a href={item.link}>Ver proyecto o planificación <span aria-hidden="true">↗</span></a>
      </article>)}
    </div>
  </section>
  <section class="wrap roadmap-body" aria-labelledby="community-title">
    <h2 id="community-title">Software gratuito, comunidad abierta</h2>
    <p>Definitive Randomizer y Progressive Tracker seguirán siendo gratuitos. El desarrollo se apoya de forma voluntaria a través de Ko-fi y contenido en español, sin anuncios invasivos ni funciones esenciales bloqueadas.</p>
    <p>El siguiente objetivo es estabilizar Definitive Randomizer. Más adelante, un formato de intercambio versionado permitirá que Progressive Tracker reconozca los datos personalizados de un proyecto.</p>
    <p><a href="https://github.com/joanjuz/DefinitivePkm/blob/main/docs/ROADMAP.md">Leer el roadmap maestro en GitHub ↗</a></p>
    <p><a href="https://github.com/joanjuz/DefinitivePkm/blob/main/docs/COMMUNITY.md">Conocer la estrategia de comunidad ↗</a></p>
    <p><a href={sitePath()}>Volver al inicio</a></p>
  </section>
</Layout>
<style>
  .roadmap-hero { padding-block: clamp(3rem, 8vw, 6rem) 2rem; max-width: 1050px; }
  .eyebrow,.status { color: #aab9e5; font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  h1 { font-size: clamp(2.25rem, 6vw, 4.5rem); letter-spacing: -.045em; line-height: 1.08; max-width: 850px; margin: .5rem 0 1.2rem; }
  .roadmap-hero > p:not(.eyebrow) { max-width: 780px; line-height: 1.7; }
  .note { color: #b8bbc3; font-size: .94rem; }
  .roadmap-body { padding-block: 1.4rem 3rem; }
  h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0 0 1.25rem; }
  .initiative-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,270px),1fr)); gap: 1rem; }
  .initiative { border: 1px solid #383e48; border-radius: 16px; padding: 1.45rem; background: #1c2027; display: flex; flex-direction: column; }
  .initiative h3 { font-size: 1.25rem; margin: .35rem 0; }
  .initiative p:not(.status) { color: #c9cbd0; line-height: 1.65; flex: 1; }
  .initiative a,.roadmap-body a { color: #b5cdfd; text-underline-offset: 3px; }
  .roadmap-body > p { max-width: 800px; line-height: 1.7; }
</style>
